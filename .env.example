# Chatwoot connection
CHATWOOT_BASE_URL=http://chatwoot_rails_1:3000
CHATWOOT_API_TOKEN=your-agent-or-admin-api-token
CHATWOOT_ACCOUNT_IDS=[1]

# Evolution API  — when set, enables LID resolution for read receipts
# LID = Linked ID JIDs (e.g. 54958938411215@lid); without this, LID receipts may not match Chatwoot contacts
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=your-evolution-api-key

# Redis — when set, pushes broadcast triggers for real-time UI update
#Use the same Redis as Chatwoot; host chatwoot-redis-1 when on chatwoot_default network
REDIS_URL=redis://:REDIS_PASSWORD@chatwoot-redis-1:6379/0

# Broadcast daemon (required for broadcast-daemon service) to enable real-time UI update via Rails Object
# Copy these from your Chatwoot .env; hostnames use Docker service names on chatwoot_default
# REDIS_URL=redis://:REDIS_PASSWORD@chatwoot-redis-1:6379/0
# DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@chatwoot-postgres-1:5432/chatwoot
# SECRET_KEY_BASE=<copy from Chatwoot .env>

# Service settings
LOG_LEVEL=INFO
PORT=3100
